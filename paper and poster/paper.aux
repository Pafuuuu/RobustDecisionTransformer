\newlabel{fig:blockpat}{{1}{2}{Random vs.\ block corruption pattern. Both inject noise into the same fraction $\rho $ of transitions but block corruption concentrates that noise in contiguous windows, mimicking sensor outages or burst failures more closely than i.i.d.\ noise.\relax }{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Main replication on Walker2d-medium-replay-v2 under mixed random corruption ($\rho =0.3$). Sequence-modeling methods (RDT, DT) clearly outperform the TD-based baseline RIQL, replicating Claim\nobreakspace  {}1. RDT only narrowly beats DT, partially supporting Claim\nobreakspace  {}2.\relax }}{2}{figure.caption.5}\protected@file@percent }
\newlabel{fig:main}{{2}{2}{Main replication on Walker2d-medium-replay-v2 under mixed random corruption ($\rho =0.3$). Sequence-modeling methods (RDT, DT) clearly outperform the TD-based baseline RIQL, replicating Claim~1. RDT only narrowly beats DT, partially supporting Claim~2.\relax }{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Claim 2: RDT $>$ DT under random and adversarial corruption}{2}{subsection.3.2}\protected@file@percent }
